# Copy this file to ".env" and fill in your own values. Never commit ".env".
# Find both values in Supabase: Project Settings -> API.
# Only use the public "anon" / "publishable" key here. NEVER put the service_role key in this project.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
