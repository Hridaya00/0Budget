# Copy this file to ".env" (same folder) and replace the placeholder values with your own.
# Never commit ".env" - it is already listed in .gitignore.
#
# Find both values in your Supabase dashboard: Project Settings -> API Keys.
#   VITE_SUPABASE_URL              -> the "Project URL"
#   VITE_SUPABASE_PUBLISHABLE_KEY  -> the PUBLISHABLE key (it starts with sb_publishable_...)
#                                     or the legacy "anon" public key.
#
# NEVER put the "secret" key or the "service_role" key here. Everything in a Vite app is visible to
# every visitor of your website.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
